-- 🏠 自動搜尋房屋
local function tp_ScanHouses()
    tp_houseListMap = {}
    local options = {}
    local savedPositions = {}
    local seenDisplayNames = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("BasePart") then
            local rawName = obj.Name
            local nameLower = string.lower(rawName)

            if string.match(nameLower, ".*house%d*$") then
                local pos = tp_GetObjectPosition(obj)
                if pos then
                    local isTooClose = false
                    for _, savedPos in ipairs(savedPositions) do
                        if (pos - savedPos).Magnitude < MIN_HOUSE_DISTANCE then
                            isTooClose = true
                            break
                        end
                    end

                    if not isTooClose then
                        local ownerName = "無人占領"
                        local ownerVal = obj:FindFirstChild("Owner") or obj:FindFirstChild("Player") or obj:FindFirstChild("HouseOwner")
                        if ownerVal then
                            if ownerVal:IsA("StringValue") and ownerVal.Value ~= "" then
                                ownerName = ownerVal.Value
                            elseif ownerVal:IsA("ObjectValue") and ownerVal.Value then
                                ownerName = ownerVal.Value.Name
                            end
                        end

                        local displayName = rawName .. " (房主: " .. ownerName .. ")"

                        if not seenDisplayNames[displayName] then
                            seenDisplayNames[displayName] = true
                            table.insert(savedPositions, pos)
                            tp_houseListMap[displayName] = obj
                            table.insert(options, displayName)
                        end
                    end
                end
            end
        end
    end

    if #options == 0 then
        table.insert(options, "未搜尋到房屋")
    end

    return options
end

-- 🥷 核心邏輯：使用 NinjaShuriken 機制破壞指定 TargetPart
local function tp_BreakTargetWithShuriken(targetPart)
    local LocalPlayer = aa4 or game.Players.LocalPlayer
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Workspace = game:GetService("Workspace")

    local inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if not inv then
        if aa56 and aa56.MakeNotification then
            aa56:MakeNotification({Name = "⚠️ 錯誤", Content = "找不到 SpawnedInToys 資料夾！", Time = 3})
        end
        return false
    end

    local currentHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not currentHRP then return false end

    local shur = nil
    local conn = inv.ChildAdded:Connect(function(child)
        if child.Name == "NinjaShuriken" then
            shur = child
            conn:Disconnect()
        end
    end)

    -- 生成 NinjaShuriken
    ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("NinjaShuriken", currentHRP.CFrame * CFrame.new(5, 8, 20), Vector3.new(0, 0, 0))

    local startTime = tick()
    repeat
        if shur and shur:FindFirstChild("StickyPart") and shur:FindFirstChild("SoundPart") then break end
        task.wait(0.01)
    until tick() - startTime > 0.5

    shur = shur or inv:FindFirstChild("NinjaShuriken")
    if shur then
        local soundPart = shur:FindFirstChild("SoundPart")
        local stickyPart = shur:FindFirstChild("StickyPart")

        if soundPart and stickyPart then
            -- 奪取 Network Owner
            local setOwner = ReplicatedStorage:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
            for j = 1, 15 do
                setOwner:FireServer(soundPart, soundPart.CFrame)
                if soundPart:FindFirstChild("PartOwner") and soundPart.PartOwner.Value == LocalPlayer.Name then break end
            end

            -- 將手裏劍設為無碰撞與透明
            for _, obj in pairs(shur:GetChildren()) do
                if obj:IsA("BasePart") then
                    obj.CanTouch = false
                    obj.CanCollide = false
                    obj.Transparency = 1
                end
            end
            shur.Name = "Noclipped"

            -- 將選中的物體透過 StickyPartEvent 移動至無窮遠破壞
            ReplicatedStorage.PlayerEvents.StickyPartEvent:FireServer(stickyPart, targetPart, CFrame.new(1e12, 1e12, 1e12))
            return true
        end
    end
    return false
end

