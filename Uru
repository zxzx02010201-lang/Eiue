                            purgeAllGrabLines()
                        end
                        task.wait(0.1)
                    end
                end)
            else
                purgeAllGrabLines()
            end
        end
    })

    -- ==========================================
    -- 7. 包裹卡頓 (Packet Lag) 獨立區塊 (已強化關閉即時釋放與回收)
    -- ==========================================
    KickTab:AddSection({Name = "--- [ 包裹卡頓 (Packet Lag) 控制 ] ---"})

    local packetLagActive = false
    local packetLagTask = nil
    local packetLagSize = 1

    local function getPacketSize()
        return packetLagSize * 1000000
    end

    KickTab:AddSlider({
        Name = "📦 Packet Size (MB)",
        Min = 1,
        Max = 20,
        Default = 1,
        Increment = 1,
        ValueName = "MB",
        Callback = function(v)
            packetLagSize = v
        end
    })

    KickTab:AddButton({
        Name = "📦 發送包裹卡頓 (單次)",
        Callback = function()
            local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
            local ExtendGrabLine = GrabEvents and GrabEvents:FindFirstChild("ExtendGrabLine")
            if not ExtendGrabLine then return end
            local size = getPacketSize()
            pcall(function()
                ExtendGrabLine:FireServer(string.rep("A", size))
            end)
        end
    })

    KickTab:AddToggle({
        Name = "📦 包裹卡頓 (迴圈循環)",
        Default = false,
        Callback = function(Value)
            packetLagActive = Value
            if packetLagTask then
                task.cancel(packetLagTask)
                packetLagTask = nil
            end
            
            if Value then
                packetLagTask = task.spawn(function()
                    local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
                    local ExtendGrabLine = GrabEvents and GrabEvents:FindFirstChild("ExtendGrabLine")
                    if not ExtendGrabLine then
                        packetLagActive = false
                        return
                    end
                    local size = getPacketSize()
                    while packetLagActive do
                        pcall(function()
                            ExtendGrabLine:FireServer(string.rep("A", size))
                        end)
                        task.wait(0.5)
                    end
                end)
            else
                -- 🚨 關閉包裹卡頓時執行一次極小字串或清除動作來回收遠端狀態
                pcall(function()
                    local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
                    local ExtendGrabLine = GrabEvents and GrabEvents:FindFirstChild("ExtendGrabLine")
                    if ExtendGrabLine then
                        ExtendGrabLine:FireServer("")
                    end
                end)
            end
        end
    })

    KickTab:AddSection({Name = "--- [ 各模式獨立開關控制 ] ---"})
    KickTab:AddToggle({Name = "開啟 巨人踢 v1", Default = false, Callback = function(on) if autoSitEnabled then toggleV1Kick(on) else toggleV1Kick(false) end end})
    KickTab:AddToggle({Name = "開啟 67踢", Default = false, Callback = function(on) if autoSitEnabled then toggle67Kick(on) else toggle67Kick(false) end end})
    KickTab:AddToggle({Name = "開啟 上下踢", Default = false, Callback = function(on) if autoSitEnabled then toggleUpDownKick(on) else toggleUpDownKick(false) end end})
    KickTab:AddToggle({Name = "開啟 上下踢（進階版）", Default = false, Callback = function(on) if autoSitEnabled then toggleAdvUpKick(on) else toggleAdvUpKick(false) end end})
    KickTab:AddToggle({Name = "開啟 斜踢", Default = false, Callback = function(on) if autoSitEnabled then toggleSlantKick(on) else toggleSlantKick(false) end end})
    KickTab:AddToggle({Name = "開啟 甩尾踢", Default = false, Callback = function(on) if autoSitEnabled then toggleDriftKick(on) else toggleDriftKick(false) end end})
    KickTab:AddToggle({Name = "開啟 360度踢", Default = false, Callback = function(on) if autoSitEnabled then toggle360CircleKick(on) else toggle360CircleKick(false) end end})
    KickTab:AddToggle({Name = "開啟 背甩踢", Default = false, Callback = function(on) if autoSitEnabled then toggleBackDriftKick(on) else toggleBackDriftKick(false) end end})
    KickTab:AddToggle({Name = "開啟 雙踢模式", Default = false, Callback = function(on) if autoSitEnabled then toggleDualKick(on) else toggleDualKick(false) end end})

end)
